# Copy to .env (git-ignored). Everything here is optional - jobradar works with none of it.

# Free Gemini key from https://aistudio.google.com/apikey  -> enables AI eligibility check + fit score + drafts
GEMINI_API_KEY=

# Telegram digest (free): create a bot with @BotFather, then message it once and read chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email digest via Gmail SMTP: needs a Google "App password" (Google Account > Security > App passwords)
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Resume as plain text (used when profile/resume.* is not present, e.g. in GitHub Actions)
JOBRADAR_RESUME_TEXT=
